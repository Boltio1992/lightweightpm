# ---- Supabase ----
# Supabase Dashboard -> Project Settings -> Data API  (Project URL)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase Dashboard -> Project Settings -> API Keys -> service_role (secret)
# NEVER expose this to the browser. It is only used inside API routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Session ----
# Any long random string. Generate one with:  openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-string
